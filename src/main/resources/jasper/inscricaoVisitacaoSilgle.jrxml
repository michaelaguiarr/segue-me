	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Segue-me"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<queryString>
		<![CDATA[SELECT
public.inscricao.id,
public.inscricao.numero,
public.segue_me.cidade,
public.segue_me.data_fim,
public.segue_me.data_inicio,
public.segue_me.estado,
public.segue_me.padroeiro,
public.segue_me.titulo,
public.numero_romano.numero,
public.numero_romano.numero_romano,
public.paroquias.descricao as paroquia,
public.paroquias.cidade AS paroquia_cidade_0,
public.paroquias.estado AS paroquia_estado_0,
public.evento_segue_me.idade_no_evento AS idade,
public.seguidor.dt_nascimento,
public.seguidor.email,
public.seguidor.filiacao_mae,
public.seguidor.filiacao_pai,
public.seguidor.nacionalidade,
public.seguidor.naturalidade,
public.seguidor.nome as nome_seguidor,
public.seguidor.rede_social_facebook,
public.seguidor.rede_social_instagram,
public.seguidor.rede_social_twitter,
public.seguidor.telefone_um AS seguidor_telefone,
public.endereco.bairro AS endereco_bairro,
public.endereco.cidade AS endereco_cidade,
public.endereco.cep,
public.endereco.complemento,
public.endereco.estado AS endereco_estado,
public.endereco.logradouro,
public.endereco.numero AS endereco_numero,
public.sexo.nome AS sexo,
public.inscricao.endereco_convidou,
public.inscricao.dt_inscricao,
public.inscricao.informacao_extras,
public.inscricao.mora_com_pais,
public.inscricao.nome_convidou,
public.inscricao.religiao AS inscricao_religiao,
public.inscricao.sagramento_batismo AS sagramento_batismo_0,
public.inscricao.sagramento_crisma AS sagramento_crisma_0,
public.inscricao.sagramento_eucaristia AS sagramento_eucaristia_0,
public.inscricao.situacaoescolaridade AS situacaoescolaridade_0,
public.inscricao.statusinscricao,
public.inscricao.telefone_convidou,
public.inscricao.igreja,
public.inscricao.instituicao AS instituicao_0,
public.inscricao.movimentos AS movimentos_0,
public.inscricao.escolaridade AS escolaridade_0,
public.inscricao.curso AS curso_0,
public.seguidor.telefone_mae,
public.seguidor.telefone_pai
FROM
public.segue_me
JOIN public.evento_segue_me
ON public.segue_me.id = public.evento_segue_me.fk_segue_me_id 
JOIN public.numero_romano
ON public.numero_romano.id = public.segue_me.fk_numero_cod 
JOIN public.paroquias
ON public.segue_me.paroquia_id = public.paroquias.id 
JOIN public.seguidor
ON public.evento_segue_me.fk_seguidor_id = public.seguidor.id 
JOIN public.endereco
ON public.endereco.cod = public.seguidor.fk_endereco_id 
JOIN public.sexo
ON public.sexo.cod = public.seguidor.fk_sexo_id 
JOIN public.inscricao
ON public.evento_segue_me.fk_inscricao_id = public.inscricao.id
WHERE public.inscricao.statusinscricao = 'INSCRITO'
ORDER BY
public.inscricao.id ASC]]>
	</queryString>
