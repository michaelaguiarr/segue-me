	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Segue-me"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="contato1" class="java.lang.String"/>
	<parameter name="contato2" class="java.lang.String"/>
	<parameter name="contato3" class="java.lang.String"/>
	<parameter name="segueMe" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT
inscricao.numero,
"numero_romano"."numero_romano"
FROM
"evento_segue_me"
JOIN inscricao
ON "evento_segue_me"."fk_inscricao_id" = inscricao."id" 
JOIN "segue_me"
ON "evento_segue_me"."fk_segue_me_id" = "segue_me"."id" 
JOIN "numero_romano"
ON "segue_me"."fk_numero_cod" = "numero_romano"."id"
WHERE
inscricao.statusinscricao = 'PENDENTE' AND
inscricao.ficha_do_padre = TRUE AND
evento_segue_me.fk_segue_me_id =  $P{segueMe} 
ORDER BY
inscricao.numero ASC]]>
	</queryString>
	<field name="numero" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.label" value="numero"/>
	</field>
	<field name="numero_romano" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="numero_romano"/>
	</field>
