<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="inscricao" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f4ab04ca-0240-4aa7-8313-3aef3d418309">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Segue-me"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="status" class="java.lang.String"/>
	<parameter name="segueMe" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT
public.inscricao.id,
public.inscricao.numero,
public.segue_me.cidade,
public.segue_me.data_fim,
public.segue_me.data_inicio,
public.segue_me.data_inicio + 1 as data_meio,
public.segue_me.estado,
public.segue_me.padroeiro,
public.segue_me.titulo,
public.numero_romano.numero,
public.numero_romano.numero_romano,
public.paroquias.descricao AS paroquia,
public.paroquias.cidade AS paroquia_cidade_0,
public.paroquias.estado AS paroquia_estado_0,
public.evento_segue_me.idade_no_evento AS idade,
public.seguidor.dt_nascimento,
public.seguidor.telefone_um AS seguidor_telefone,
public.sexo.nome AS sexo,
public.inscricao.statusinscricao,
public.endereco.bairro,
public.endereco.cidade AS cidade_0,
public.seguidor.nome,
EXTRACT(YEAR FROM public.seguidor.dt_nascimento) as ano
FROM
public.segue_me
JOIN public.evento_segue_me
ON public.segue_me.id = public.evento_segue_me.fk_segue_me_id 
JOIN public.numero_romano
ON public.numero_romano.id = public.segue_me.fk_numero_cod 
JOIN public.paroquias
ON public.segue_me.paroquia_id = public.paroquias.id 
JOIN public.seguidor
ON public.evento_segue_me.fk_seguidor_id = public.seguidor.id 
JOIN public.sexo
ON public.sexo.cod = public.seguidor.fk_sexo_id 
JOIN public.inscricao
ON public.evento_segue_me.fk_inscricao_id = public.inscricao.id 
JOIN public.endereco
ON public.endereco.cod = public.seguidor.fk_endereco_id
WHERE
public.evento_segue_me.idade_no_evento < 20
AND public.inscricao.statusinscricao = $P{status} 
AND public.segue_me.id = $P{segueMe} 
ORDER BY
ano,
public.endereco.bairro ASC,
sexo]]>
	</queryString>
