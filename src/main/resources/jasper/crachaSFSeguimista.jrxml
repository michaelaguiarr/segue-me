	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SEGUE-ME"/>
	<parameter name="segueMe" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT
public.evento_segue_me.id AS id,
public.evento_segue_me.cracha,
public.seguidor.apelido,
public.evento_segue_me.fk_segue_me_id,
public.segue_me.data_fim,
public.segue_me.data_inicio,
public.paroquias.descricao,
public.paroquias.cidade,
public.paroquias.estado,
public.segue_me.padroeiro,
public.numero_romano.numero_romano,
public.seguidor.id AS seguidor_id,
public.evento_segue_me.fk_circulo_id,
public.circulo.corcirculo,
public.circulo.nome
FROM
public.evento_segue_me
JOIN public.seguidor
ON public.evento_segue_me.fk_seguidor_id = public.seguidor.id 
JOIN public.segue_me
ON public.segue_me.id = public.evento_segue_me.fk_segue_me_id 
JOIN public.paroquias
ON public.segue_me.paroquia_id = public.paroquias.id 
JOIN public.numero_romano
ON public.numero_romano.id = public.segue_me.fk_numero_cod 
JOIN public.circulo
ON public.evento_segue_me.fk_circulo_id = public.circulo.id
WHERE
public.evento_segue_me.fk_inscricao_id is not null and
public.evento_segue_me.fk_segue_me_id =  $P{segueMe}  and
public.evento_segue_me.cracha = true]]>
	</queryString>
