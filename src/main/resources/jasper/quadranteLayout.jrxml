	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SEGUE-ME"/>
	<parameter name="segueMe" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[SELECT
public.segue_me.cidade AS segue_me_cidade,
public.segue_me.data_fim AS segue_me_data_fim,
public.segue_me.data_inicio AS segue_me_data_inicio,
public.segue_me.estado AS segue_me_estado,
public.segue_me.padroeiro AS segue_me_padroeiro,
public.segue_me.nomeclatura AS segue_me_nomeclatura,
public.segue_me.titulo AS segue_me_titulo,
public.numero_romano.numero AS segue_me_numero,
public.numero_romano.numero_romano,
public.paroquias.descricao AS paroquias_descricao_0,
public.paroquias.cidade AS paroquias_cidade_0,
public.paroquias.estado AS paroquias_estado_0,
public.segue_me.id
FROM
public.segue_me
JOIN public.numero_romano
ON public.segue_me.fk_numero_cod = public.numero_romano.id 
JOIN public.paroquias
ON public.paroquias.id = public.segue_me.paroquia_id
WHERE
public.segue_me.id =    $P{segueMe}]]>
	</queryString>
