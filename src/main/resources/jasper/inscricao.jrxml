<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="inscricao" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f4ab04ca-0240-4aa7-8313-3aef3d418309">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Segue-me"/>
	<parameter name="status" class="java.lang.String"/>
	<parameter name="segueMe" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT
public.inscricao.id,
public.inscricao.numero,
public.segue_me.titulo,
public.segue_me.data_fim,
public.segue_me.data_inicio,
public.segue_me.data_inicio+1 as data_meio,
public.numero_romano.numero_romano,
public.paroquias.descricao,
public.inscricao.statusinscricao,
public.paroquias.cidade,
public.paroquias.estado
FROM
public.inscricao
JOIN public.evento_segue_me
ON public.inscricao.id = public.evento_segue_me.fk_inscricao_id 
JOIN public.segue_me
ON public.evento_segue_me.fk_segue_me_id = public.segue_me.id 
JOIN public.numero_romano
ON public.segue_me.fk_numero_cod = public.numero_romano.id 
JOIN public.paroquias
ON public.segue_me.paroquia_id = public.paroquias.id
WHERE
public.inscricao.statusinscricao =  $P{status}  
AND public.segue_me.id = $P{segueMe} 
ORDER BY
public.inscricao.id ASC]]>
	</queryString>
