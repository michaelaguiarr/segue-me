<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.1"
	xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd">

	<!--
		DataSource gerenciado pelo TomEE (config/tomee.xml).
		RESOURCE_LOCAL preserva o interceptor customizado util/jpa/@Transactional.
		Para produção (JBoss/WildFly), trocar pelo datasource JNDI do servidor.
	-->
	<persistence-unit name="ejc" transaction-type="RESOURCE_LOCAL">
		<provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

		<non-jta-data-source>java:comp/env/seguemeDS</non-jta-data-source>

		<properties>
			<property name="hibernate.show_sql" value="false" />
			<property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQL95Dialect" />
			<!-- Adia o acesso ao CDI BeanManager para após o contexto TomEE estar pronto -->
			<property name="hibernate.delay_cdi_access" value="true" />
		</properties>
	</persistence-unit>

</persistence>