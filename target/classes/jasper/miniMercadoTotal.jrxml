<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="quadranteSeguidor" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a71ed9bd-1d82-4eaa-901f-34a0ff606867">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SEGUE-ME"/>
	<parameter name="segueMe" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[SELECT
public.segue_me.cidade AS segue_me_cidade,
public.segue_me.data_fim AS segue_me_data_fim,
public.segue_me.data_inicio AS segue_me_data_inicio,
public.segue_me.estado AS segue_me_estado,
public.segue_me.padroeiro AS segue_me_padroeiro,
public.segue_me.nomeclatura AS segue_me_nomeclatura,
public.segue_me.titulo AS segue_me_titulo,
public.numero_romano.numero AS segue_me_numero,
public.numero_romano.numero_romano,
public.paroquias.descricao AS paroquias_descricao_0,
public.paroquias.cidade AS paroquias_cidade_0,
public.paroquias.estado AS paroquias_estado_0,
public.segue_me.id,
public.venda_segue_me.status_venda AS venda_status_venda,
SUM(public.venda_segue_me.valor_total) AS venda_valor_total
FROM
public.segue_me
JOIN public.numero_romano
ON public.segue_me.fk_numero_cod = public.numero_romano.id 
JOIN public.paroquias
ON public.paroquias.id = public.segue_me.paroquia_id 
JOIN public.venda_segue_me
ON public.segue_me.id = public.venda_segue_me.fk_segue_me_id
WHERE
public.segue_me.id = $P{segueMe}  
GROUP BY
public.segue_me.cidade,
public.segue_me.data_fim ,
public.segue_me.data_inicio ,
public.segue_me.estado ,
public.segue_me.padroeiro ,
public.segue_me.nomeclatura ,
public.segue_me.titulo,
public.numero_romano.numero ,
public.numero_romano.numero_romano,
public.paroquias.descricao ,
public.paroquias.cidade ,
public.paroquias.estado ,
public.segue_me.id,
public.segue_me.id,
public.venda_segue_me.status_venda
ORDER BY
public.venda_segue_me.status_venda]]>
	</queryString>
