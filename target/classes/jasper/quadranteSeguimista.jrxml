<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="quadranteSeguidor" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a71ed9bd-1d82-4eaa-901f-34a0ff606867">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SEGUE-ME"/>
	<parameter name="pagina" class="java.lang.Integer"/>
	<parameter name="segueMe" class="java.lang.Long"/>
	<parameter name="circulo" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[SELECT
public.evento_segue_me.fk_equipe_id,
public.evento_segue_me.fk_funcao_id,
public.funcao.descricao AS funcao_descricao,
public.funcao.ordem AS funcao_ordem,
public.evento_segue_me.idade_no_evento,
public.evento_segue_me.motivo_recusa,
public.evento_segue_me.statusconvite,
public.evento_segue_me.timestamp,
public.evento_segue_me.fk_seguidor_id,
public.seguidor.nome,
public.seguidor.apelido,
public.seguidor.email,
public.seguidor.telefone_um,
public.seguidor.dt_nascimento,
public.evento_segue_me.fk_casal_id,
public.casal.nome_ele,
public.casal.dt_nascimento_ele,
public.casal.email_ele,
public.casal.telefone_ele_um,
public.casal.apelido_ele,
public.casal.nome_ela,
public.casal.dt_nascimento_ela,
public.casal.email_ela,
public.casal.telefone_ela_um,
public.casal.apelido_ela,
public.evento_segue_me.fk_segue_me_id,
public.segue_me.cidade AS segue_me_cidade,
public.segue_me.data_fim AS segue_me_data_fim,
public.segue_me.data_inicio AS segue_me_data_inicio,
public.segue_me.estado AS segue_me_estado,
public.segue_me.padroeiro AS segue_me_padroeiro,
public.segue_me.titulo AS segue_me_titulo,
public.numero_romano.numero AS segue_me_numero,
public.numero_romano.numero_romano,
public.paroquias.descricao AS paroquias_descricao_0,
public.paroquias.cidade AS paroquias_cidade_0,
public.paroquias.estado AS paroquias_estado_0,
public.endereco.logradouro,
public.endereco.numero,
public.endereco.bairro,
public.endereco.cidade,
public.endereco.estado,
public.inscricao.id,
public.evento_segue_me.fk_inscricao_id,
public.inscricao.statusinscricao,
public.circulo.corcirculo,
public.circulo.nome AS nome_0,
public.evento_segue_me.fk_circulo_id
FROM
public.evento_segue_me
LEFT JOIN public.funcao
ON public.evento_segue_me.fk_funcao_id = public.funcao.id 
LEFT JOIN public.seguidor
ON public.evento_segue_me.fk_seguidor_id = public.seguidor.id 
LEFT JOIN public.casal
ON public.casal.id = public.evento_segue_me.fk_casal_id 
JOIN public.segue_me
ON public.evento_segue_me.fk_segue_me_id = public.segue_me.id 
JOIN public.numero_romano
ON public.segue_me.fk_numero_cod = public.numero_romano.id 
JOIN public.paroquias
ON public.paroquias.id = public.segue_me.paroquia_id 
JOIN "public".endereco
ON "public".seguidor."fk_endereco_id" = "public".endereco.cod
OR "public".casal."fk_endereco_id" = "public".endereco.cod
LEFT JOIN public.inscricao
ON public.evento_segue_me.fk_inscricao_id = public.inscricao.id 
LEFT JOIN public.circulo
ON public.circulo.id = public.evento_segue_me.fk_circulo_id
WHERE
public.evento_segue_me.fk_segue_me_id =   $P{segueMe} AND 
public.evento_segue_me.fk_circulo_id =  $P{circulo} AND 
(public.inscricao.statusinscricao like 'APROVADO' OR
public.evento_segue_me.fk_funcao_id = 58 OR
public.evento_segue_me.fk_funcao_id = 59 )
ORDER BY
public.circulo.corcirculo ASC,
funcao_ordem ASC,
public.casal.nome_ele ASC,
public.seguidor.nome ASC]]>
	</queryString>
