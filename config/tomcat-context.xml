<?xml version="1.0" encoding="UTF-8"?>
<!--
  Descriptor de contexto por-app para Tomcat (dev/Docker).
  Este arquivo é montado em conf/Catalina/localhost/segue-me.xml pelo Dockerfile,
  substituindo o META-INF/context.xml do WAR.

  Inclui o BeanManager via Weld (funciona no Tomcat, onde não há CDI nativo)
  e o DataSource JNDI apontando para o PostgreSQL do Docker.
-->
<Context>
  <!-- Não persistir sessões em disco entre restarts -->
  <Manager pathname="" />

  <!-- CDI BeanManager via Weld-servlet (compatível com Tomcat) -->
  <Resource name="BeanManager" auth="Container"
    type="javax.enterprise.inject.spi.BeanManager"
    factory="org.jboss.weld.resources.ManagerObjectFactory" />

  <!-- DataSource Docker — hostname "postgres" é o serviço no docker-compose.yml -->
  <!-- Propriedades DBCP2 (Tomcat 9): maxTotal/maxWaitMillis em vez de maxActive/maxWait -->
  <Resource name="seguemeDS"
    auth="Container"
    type="javax.sql.DataSource"
    driverClassName="org.postgresql.Driver"
    url="jdbc:postgresql://postgres:5432/segueme"
    username="segueme"
    password="segueme123"
    maxTotal="10"
    maxIdle="5"
    minIdle="2"
    maxWaitMillis="30000"
    validationQuery="SELECT 1"
    testOnBorrow="true" />
</Context>
