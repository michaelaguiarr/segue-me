# =============================================================================
# Variáveis de ambiente — Produção
# =============================================================================
# Copie este arquivo para .env e preencha com os valores reais:
#   cp .env.prod.example .env
#
# ATENÇÃO: o arquivo .env está no .gitignore e NUNCA deve ser commitado.
# =============================================================================

# --- Banco de dados PostgreSQL ---

# Usuário do banco
DB_USER=segueme

# Senha do banco (use uma senha forte em produção)
DB_PASSWORD=

# Nome do banco
DB_NAME=segueme

# --- Servidor de aplicação ---

# Porta exposta pelo Tomcat no host.
# O proxy reverso (nginx) deve apontar para esta porta.
APP_PORT=8080
